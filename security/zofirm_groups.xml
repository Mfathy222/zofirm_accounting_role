<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_zofirm_account_supervisor" model="res.groups">
        <field name="name">Supervisor</field>
        <field name="sequence">43</field>
        <field name="comment">Supervise accounting operations, including deletion of journal entries, journals, and chart-of-accounts records, without access to accounting lock dates.</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>

    <record id="group_zofirm_account_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">45</field>
        <field name="comment">Manage accounting operations and lock dates, including deletion of journal entries and journals, without full accounting administration.</field>
        <field name="privilege_id" ref="account.res_groups_privilege_accounting"/>
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
