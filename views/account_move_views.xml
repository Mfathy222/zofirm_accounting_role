<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_tree_zofirm_bulk_actions" model="ir.ui.view">
        <field name="name">account.move.list.zofirm.bulk.actions</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <header>
                    <button name="action_zofirm_bulk_reset_to_draft"
                            type="object"
                            string="Reset to Draft"
                            class="zofirm_reset_to_draft_btn"
                            groups="account.group_account_user,account.group_account_manager"/>
                    <button name="action_zofirm_bulk_confirm"
                            type="object"
                            string="Confirm"
                            class="btn-primary zofirm_confirm_btn"
                            groups="account.group_account_user,account.group_account_manager"/>
                </header>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_zofirm_active_company" model="ir.ui.view">
        <field name="name">account.move.form.zofirm.active.company</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='journal_id'])[1]" position="after">
                <field name="zofirm_active_company_name"
                       string="Active Company"
                       readonly="1"
                       invisible="move_type != 'entry'"/>
            </xpath>
        </field>
    </record>

</odoo>
