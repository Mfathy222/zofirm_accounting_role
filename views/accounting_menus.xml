<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Let Bookkeeper/roles open Configuration; child-menu security still applies. -->
    <record id="account.menu_finance_configuration" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('account.group_account_user')), (4, ref('zofirm_accounting_role.group_zofirm_account_manager'))]"/>
    </record>

    <record id="account.account_account_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('account.group_account_user')), (4, ref('zofirm_accounting_role.group_zofirm_account_manager'))]"/>
    </record>

    <record id="account.menu_action_account_journal_form" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('account.group_account_user')), (4, ref('zofirm_accounting_role.group_zofirm_account_manager'))]"/>
    </record>

    <!-- Use Odoo's native account.change.lock.date wizard; do not create a custom wizard. -->
    <function model="ir.ui.menu" name="zofirm_configure_native_lock_dates"/>

    <!-- Accounting Administrator only; placed below the other Configuration entries. -->
    <menuitem id="menu_zofirm_companies"
              name="Companies"
              parent="account.menu_finance_configuration"
              action="base.action_res_company_form"
              groups="account.group_account_manager"
              sequence="999"/>
</odoo>
