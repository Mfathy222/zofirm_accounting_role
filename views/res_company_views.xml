<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_zofirm_accounting_role" model="ir.ui.view">
        <field name="name">res.company.form.zofirm.accounting.role</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group/group[2]" position="inside">
                <field name="user_ids"
                       string="Users"
                       widget="many2many_tags"
                       options="{'no_create': True}"
                       groups="account.group_account_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
