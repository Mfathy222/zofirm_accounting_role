<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Stable Active-Company scope for Odoo 19 Accounting.

        We intentionally DO NOT rewrite allowed_company_ids. Odoo keeps its native
        multi-company context and record rules, so opening Journal Items/forms and
        report drill-downs remains stable. The Accounting actions themselves carry
        a non-removable domain on the current company, where allowed_company_ids[0]
        is Odoo's current/active company.
    -->

    <!-- Accounting Dashboard -->
    <record id="account.open_account_journal_dashboard_kanban" model="ir.actions.act_window">
        <field name="context">{'search_default_dashboard': 1, 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('company_id', '=', allowed_company_ids[0])]</field>
    </record>

    <!-- Journal Entries -->
    <record id="account.action_move_journal_line" model="ir.actions.act_window">
        <field name="context">{'default_move_type': 'entry', 'search_default_posted': 1, 'view_no_maturity': True, 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('company_id', '=', allowed_company_ids[0])]</field>
    </record>

    <!-- Journal Items -->
    <record id="account.action_account_moves_all" model="ir.actions.act_window">
        <field name="context">{'journal_type': 'general', 'search_default_posted': 1, 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_subsection', 'line_note')), ('parent_state', '!=', 'cancel'), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>

    <!-- Journals -->
    <record id="account.action_account_journal_form" model="ir.actions.act_window">
        <field name="context">{'zofirm_accounting_scope': True}</field>
        <field name="domain">[('company_id', '=', allowed_company_ids[0])]</field>
    </record>

    <!-- Chart of Accounts. Odoo 19 accounts can be shared with parent/branch
         companies, so keep Odoo's hierarchy semantics instead of company_id. -->
    <record id="account.action_account_form" model="ir.actions.act_window">
        <field name="context">{'zofirm_accounting_scope': True}</field>
        <field name="domain">[('company_ids', 'parent_of', allowed_company_ids[0])]</field>
    </record>

    <!-- Customer invoices / credit notes -->
    <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
        <field name="context">{'default_move_type': 'out_invoice', 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund', 'out_receipt']), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>
    <record id="account.action_move_out_invoice" model="ir.actions.act_window">
        <field name="context">{'search_default_out_invoice': 1, 'search_default_out_receipt': 1, 'default_move_type': 'out_invoice', 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund', 'out_receipt']), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>
    <record id="account.action_move_out_refund_type_non_legacy" model="ir.actions.act_window">
        <field name="context">{'search_default_out_refund': 1, 'default_move_type': 'out_refund', 'display_account_trust': True, 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('move_type', 'in', ['out_invoice', 'out_refund']), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>

    <!-- Vendor bills / refunds -->
    <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
        <field name="context">{'default_move_type': 'in_invoice', 'display_account_trust': True, 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund', 'in_receipt']), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>
    <record id="account.action_move_in_invoice" model="ir.actions.act_window">
        <field name="context">{'search_default_in_invoice': 1, 'search_default_in_receipt': 1, 'default_move_type': 'in_invoice', 'display_account_trust': True, 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund', 'in_receipt']), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>
    <record id="account.action_move_in_refund_type" model="ir.actions.act_window">
        <field name="context">{'search_default_in_refund': 1, 'default_move_type': 'in_refund', 'zofirm_accounting_scope': True}</field>
        <field name="domain">[('move_type', 'in', ['in_invoice', 'in_refund']), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>

    <!-- Amounts to Settle -->
    <record id="account.action_amounts_to_settle" model="ir.actions.act_window">
        <field name="context">{'zofirm_accounting_scope': True}</field>
        <field name="domain">[('parent_state', '=', 'posted'), ('date_maturity', '!=', False), ('amount_residual', '!=', 0), ('account_id.reconcile', '=', True), ('company_id', '=', allowed_company_ids[0])]</field>
    </record>
</odoo>
